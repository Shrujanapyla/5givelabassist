# Copy to /etc/5g-live-lab-assist/server.env and restrict it to root and the service account.
NODE_ENV=production
TRUST_PROXY=1
PORT=3000
CLIENT_ORIGIN=https://MEC_HOSTNAME_FROM_UNIVERSITY
PROFESSOR_ENROLLMENT_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
STUDENT_ENROLLMENT_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_ENROLLMENT_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MAX_STUDENTS_PER_SESSION=3
AI_SERVICE_URL=http://127.0.0.1:8000
DATA_DIR=/var/lib/5g-live-lab-assist
# Nginx terminates HTTPS. Keep Node's TLS settings empty behind the local reverse proxy.
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_KEY_PASSPHRASE=

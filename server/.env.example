# Local development template. For deployment, use deploy/.env.example and set NODE_ENV=production.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
PROFESSOR_ENROLLMENT_KEY=
STUDENT_ENROLLMENT_KEY=
ADMIN_ENROLLMENT_KEY=
MAX_STUDENTS_PER_SESSION=3
AI_SERVICE_URL=http://127.0.0.1:8000
DATA_DIR=./data

# Optional TLS (relative paths resolve from the server folder). Leave empty for localhost development.
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_KEY_PASSPHRASE=
